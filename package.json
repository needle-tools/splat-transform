{
  "name": "@playcanvas/splat-transform",
  "version": "2.7.1",
  "author": "PlayCanvas<support@playcanvas.com>",
  "homepage": "https://playcanvas.com",
  "description": "Library and CLI tool for 3D Gaussian splat format conversion and transformation",
  "keywords": [
    "3d-gaussian-splatting",
    "cli",
    "gaussian-splatting",
    "playcanvas",
    "supersplat",
    "typescript"
  ],
  "license": "MIT",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/lib/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/lib/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/browser/index.mjs"
    },
    "./worker": "./dist/worker.mjs",
    "./lib/*": "./lib/*"
  },
  "bin": {
    "splat-transform": "bin/cli.mjs"
  },
  "bugs": {
    "url": "https://github.com/playcanvas/splat-transform/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/playcanvas/splat-transform.git"
  },
  "files": [
    "dist/",
    "bin/",
    "lib/"
  ],
  "dependencies": {
    "@adobe/spz": "0.2.2",
    "fflate": "^0.8.2",
    "webgpu": "0.4.0"
  },
  "devDependencies": {
    "@sparkjsdev/spark": "^2.0.0",
    "@playcanvas/eslint-config": "2.1.0",
    "@playcanvas/supersplat-viewer": "1.26.4",
    "@playwright/test": "^1.59.1",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "24.13.2",
    "@typescript-eslint/eslint-plugin": "8.62.1",
    "@typescript-eslint/parser": "8.62.1",
    "eslint": "9.39.4",
    "eslint-import-resolver-typescript": "4.4.5",
    "pathe": "2.0.3",
    "playcanvas": "2.20.2",
    "publint": "0.3.21",
    "rollup": "4.62.2",
    "tslib": "2.8.1",
    "three": "^0.180.0",
    "tsx": "4.22.4",
    "typedoc": "0.28.19",
    "typedoc-plugin-mdn-links": "5.1.1",
    "typescript": "5.9.3",
    "vite": "^8.0.10"
  },
  "peerDependencies": {
    "playcanvas": "^2.0.0"
  },
  "scripts": {
    "build": "rollup -c && node -e \"fs=require('fs');fs.copyFileSync('dist/lib/index.d.ts','dist/lib/index.d.cts')\"",
    "build:lods": "npm run build && vite build --config vite.browser-lod.config.mjs",
    "demo:dev": "npm run build && vite --host 127.0.0.1 --port 4173 --strictPort",
    "demo:serve": "npm run demo:dev",
    "lods:dev": "npm run build && vite --config vite.browser-lod.config.mjs --host 127.0.0.1 --port 4173 --strictPort",
    "docs": "typedoc",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "publint": "publint",
    "watch": "rollup -c -w",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:serve": "npm run demo:serve",
    "test:fixtures": "node --import tsx test/fixtures/create-fixtures.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module"
}
